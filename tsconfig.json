{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "types": [], 
    "typeRoots": ["./node_modules/@types", "./@types"],
    "target": "es2017",
    "lib": ["es2017", "dom"],
    "module": "esnext",
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "@types"]
}
